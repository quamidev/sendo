{
  "name": "@quami/sendo",
  "version": "0.0.0",
  "description": "WhatsApp Cloud API library for Quami apps: webhook, messaging, agents and inbox server ops.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "sendo": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/memory": {
      "import": {
        "types": "./dist/adapters/memory/index.d.ts",
        "default": "./dist/adapters/memory/index.js"
      },
      "require": {
        "types": "./dist/adapters/memory/index.d.cts",
        "default": "./dist/adapters/memory/index.cjs"
      }
    },
    "./adapters/supabase": {
      "import": {
        "types": "./dist/adapters/supabase/index.d.ts",
        "default": "./dist/adapters/supabase/index.js"
      },
      "require": {
        "types": "./dist/adapters/supabase/index.d.cts",
        "default": "./dist/adapters/supabase/index.cjs"
      }
    },
    "./adapters/contract": {
      "import": {
        "types": "./dist/adapters/contract/index.d.ts",
        "default": "./dist/adapters/contract/index.js"
      },
      "require": {
        "types": "./dist/adapters/contract/index.d.cts",
        "default": "./dist/adapters/contract/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run test/integration --reporter=default --reporter=json --outputFile=test-results/e2e-report.json",
    "test:watch": "vitest",
    "test:supabase": "SENDO_REQUIRE_SUPABASE=1 vitest run supabase --passWithNoTests --no-file-parallelism"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "ai": "^6.0.0",
    "next": ">=15.0.0",
    "vitest": ">=3.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.20.5",
    "ai": "^6.0.301",
    "msw": "^2.15.0",
    "next": "^16.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
