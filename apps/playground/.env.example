# Copy to .env.local. Every value has a playground default, so fixtures mode runs with none.

# fixtures = in-memory adapter seeded from fixtures/ (no Docker). Remove (or set to
# "supabase") to use the root local Supabase; without Supabase env it falls back to fixtures.
SENDO_PLAYGROUND_MODE=fixtures

# Webhook secrets. The replay script signs with SENDO_META_APP_SECRET.
SENDO_META_APP_SECRET=playground-app-secret
SENDO_VERIFY_TOKEN=playground-verify-token
# Access token of the seeded account (sendo_accounts.token_ref = SENDO_TOKEN_MAIN). Leave empty to
# use the fake Meta Graph API (fixtures mode, or SENDO_PLAYGROUND_FAKE_META=true).
SENDO_TOKEN_MAIN=
SENDO_PLAYGROUND_FAKE_META=true

# AI Gateway model id for the "recepcion" agent (e.g. openai/gpt-5-mini, needs AI_GATEWAY_API_KEY).
# Empty → deterministic mock model.
SENDO_AGENT_MODEL=

# Supabase mode: root local Supabase (`pnpm supabase start` at the repo root, then
# `pnpm supabase status -o env` for the keys).
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SENDO_STORAGE_BUCKET=sendo-media

# registry:install --source url (apps/web must allow it via SENDO_REGISTRY_TOKENS).
# SENDO_REGISTRY_TOKEN=
