{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@sendo",
  "homepage": "https://registry.sendo.dev",
  "items": [
    {
      "name": "sendo-webhook",
      "type": "registry:item",
      "title": "WhatsApp webhook",
      "description": "Next.js route for the WhatsApp Cloud API webhook plus the Sendo client config (Supabase adapter, Meta direct transport).",
      "dependencies": ["@quami/sendo", "@supabase/supabase-js"],
      "files": [
        {
          "path": "registry/items/sendo-webhook/app/api/sendo/webhook/route.ts",
          "type": "registry:page",
          "target": "app/api/sendo/webhook/route.ts"
        },
        {
          "path": "registry/items/sendo-webhook/lib/sendo.ts",
          "type": "registry:lib",
          "target": "lib/sendo.ts"
        }
      ],
      "envVars": {
        "SENDO_META_APP_SECRET": "",
        "SENDO_VERIFY_TOKEN": "",
        "SENDO_TOKEN_MAIN": "",
        "SENDO_AGENT_MODEL": "",
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "SUPABASE_SERVICE_ROLE_KEY": "",
        "SENDO_STORAGE_BUCKET": "sendo-media"
      },
      "docs": "Sendo webhook installed. In Meta App Dashboard > WhatsApp > Configuration set the Callback URL to https://<your-domain>/api/sendo/webhook and the Verify token to SENDO_VERIFY_TOKEN, then subscribe to the \"messages\" field. Each sendo_accounts.token_ref names the env var holding that number's access token (e.g. SENDO_TOKEN_MAIN). Install @sendo/sendo-schema for the database, then run `npx @quami/sendo doctor`."
    },
    {
      "name": "sendo-schema",
      "type": "registry:file",
      "title": "WhatsApp schema (Supabase)",
      "description": "Supabase migration with the sendo_* tables, RLS, locks and pruning functions used by Sendo.",
      "files": [
        {
          "path": "registry/items/sendo-schema/supabase/migrations/20261010000000_sendo_v1.sql",
          "type": "registry:file",
          "target": "supabase/migrations/20261010000000_sendo_v1.sql"
        }
      ],
      "docs": "Migration added to supabase/migrations/. Apply it with `supabase db push` (or `supabase db reset` locally) and create a private Storage bucket named SENDO_STORAGE_BUCKET (default sendo-media)."
    },
    {
      "name": "sendo-inbox",
      "type": "registry:item",
      "title": "WhatsApp inbox",
      "description": "Operator inbox for Sendo: conversation list with status filters, thread with media and delivery ticks, composer with the 24-hour window and template picker, take / return / close actions, server actions and Supabase Realtime updates. Spanish by default; every string can be overridden.",
      "registryDependencies": [
        "button",
        "input",
        "textarea",
        "badge",
        "avatar",
        "scroll-area",
        "tabs",
        "dialog",
        "select",
        "tooltip",
        "sonner"
      ],
      "dependencies": ["@quami/sendo", "@supabase/supabase-js", "date-fns", "motion", "radix-ui"],
      "files": [
        {
          "path": "registry/items/sendo-inbox/components/sendo/inbox.tsx",
          "type": "registry:component",
          "target": "components/sendo/inbox.tsx"
