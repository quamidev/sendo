# Registry (shadcn add) and private npm scope
QUAMI_REGISTRY_TOKEN=

# Meta app: App settings > Basic > App secret
WA_APP_SECRET=
# Any random string; paste the same value in the Meta webhook config
WA_VERIFY_TOKEN=
# One env var per number; wa_accounts.token_ref stores this NAME, never the token
WA_TOKEN_MAIN=
# Gateway model id (needs AI_GATEWAY_API_KEY) or wire a provider model in lib/whatsapp.ts
WA_AGENT_MODEL=openai/gpt-5-mini
AI_GATEWAY_API_KEY=

# Supabase (server only for the service role key)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WA_STORAGE_BUCKET=whatsapp-media

# Optional: doctor checks this app is subscribed to your WABA
WA_APP_ID=
