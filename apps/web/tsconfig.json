{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "types": ["node", "mdx"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/sendo/*": ["../../registry/items/inbox/components/sendo/*"],
      "@/hooks/use-sendo-realtime": ["../../registry/items/inbox/hooks/use-sendo-realtime.ts"],
      "@/lib/sendo-ui": ["../../registry/items/inbox/lib/sendo-ui.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "registry-dist"]
}
