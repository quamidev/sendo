{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "registry#build"],
      "outputs": [".next/**", "!.next/cache/**", "public/llms.txt", "public/llms-full.txt"]
    },
    "test": {
      "dependsOn": ["^build", "registry#build"]
    }
  }
}
