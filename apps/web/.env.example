# Registry endpoint (GET /r/{name}.json)
#
# Comma-separated list of bearer tokens allowed to fetch registry items.
# Consumers send `Authorization: Bearer <token>` (shadcn `registries.@sendo.headers`).
# When empty or unset, every request is rejected with 401 (fails closed).
# Generate a token with: openssl rand -hex 32
SENDO_REGISTRY_TOKENS=

# Set to 1 to skip the token check. Local development only; never set it in production.
SENDO_REGISTRY_ALLOW_ANONYMOUS=

# Optional: absolute path of the built registry directory. Defaults to <app>/registry-dist.
# SENDO_REGISTRY_DIST_DIR=
